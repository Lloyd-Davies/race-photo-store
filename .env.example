# Database
POSTGRES_PASSWORD=changeme

# Container images
# Use a release tag such as v0.1.0 in production. dev-latest is for development.
IMAGE_TAG=dev-latest

# Stripe - leave blank to run without payment (checkout/webhook return 503)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
PUBLIC_BASE_URL=https://photos.yourdomain.com
# Base admin credential used for /api/admin/login
ADMIN_TOKEN=changeme-admin-token
# Secret for signed admin access/refresh session tokens
ADMIN_SESSION_SECRET=changeme-admin-session-secret
# Admin session lifetimes
ADMIN_SESSION_TTL_MINUTES=30
ADMIN_REFRESH_TTL_HOURS=12
# Lifetimes for signed event/order access tokens
EVENT_ACCESS_TTL_HOURS=12
ORDER_ACCESS_TTL_HOURS=720
# Default max uses for newly-created delivery download links
DOWNLOAD_MAX_DOWNLOADS=100
# Generated ZIP artifact lifetime and cleanup
ZIP_TTL_DAYS=3
ZIP_CLEANUP_ENABLED=true
CACHE_ROOT=/data/photos/cache
# Storage backend for generated ZIP artifacts. Use local until R2 is configured.
# ZIP_STORAGE_BACKEND overrides STORAGE_BACKEND for ZIPs only; leave blank for backwards compatibility.
STORAGE_BACKEND=local
ZIP_STORAGE_BACKEND=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=photostore
R2_ENDPOINT_URL=
R2_REGION=auto
R2_PUBLIC_BASE_URL=
# Max admin photo upload size (bytes)
MAX_PHOTO_UPLOAD_BYTES=104857600

# Branding
SITE_NAME=Race Photos
SITE_TAGLINE=Your race, your photos.

# Email
EMAIL_ENABLED=false
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Race Photos
SUPPORT_EMAIL=
ORDER_EMAIL_REQUIRED=true
BREVO_WEBHOOK_SECRET=

# Cloudflare Tunnel - get this from the Cloudflare Zero Trust dashboard
# Dashboard -> Networks -> Tunnels -> your tunnel -> Configure -> "Install and run connector"
# Copy the token from the docker run command: --token <TOKEN>
CLOUDFLARE_TUNNEL_TOKEN=
