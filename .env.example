# Required deployment values (keep the real file private).
POSTGRES_PASSWORD=
ADMIN_TOKEN=
ADMIN_SESSION_SECRET=
PUBLIC_BASE_URL=https://photos.example.com
CLOUDFLARE_TUNNEL_TOKEN=
# Verified commit-specific tag for API, worker and nginx.
IMAGE_TAG=dev-latest

# Optional display name. Title, logo URL and email sender name derive automatically.
SITE_NAME=Race Photos

# Payments: leave blank until Stripe is configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ZIPs: use local initially, or r2 once the bucket and credentials are ready.
ZIP_STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_BUCKET=photostore
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Proof/original migration remains opt-in.
PROOF_STORAGE_BACKEND=local
ORIGINAL_STORAGE_BACKEND=local

# Email: enable only after configuring the sender and credentials.
EMAIL_ENABLED=false
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
BREVO_WEBHOOK_SECRET=

# Optional overrides: .env.advanced.example; backup service: .env.backup.example.
# Copy only needed values into private Portainer settings.
